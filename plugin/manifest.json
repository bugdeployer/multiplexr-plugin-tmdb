{
  "id": "com.bugdeployer.tmdb",
  "version": "0.3.2",
  "name": "TMDB metadata",
  "entry": "plugin.js",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "capabilities": {
    "required": [
      "metadata.provide",
      "http.request",
      "credentials.use",
      "artwork.provide",
      "catalog.read"
    ],
    "optional": []
  },
  "contributions": [
    {
      "id": "com.bugdeployer.tmdb:metadata",
      "family": "metadata.provider",
      "title": "TMDB",
      "handler": "metadata.search",
      "kinds": [
        "movie",
        "television"
      ]
    },
    {
      "id": "com.bugdeployer.tmdb:artwork",
      "family": "artwork.provider",
      "title": "TMDB posters",
      "handler": "artwork.search"
    }
  ],
  "description": "Movie and TV information and posters from TMDB. Requires a TMDB API Read Access Token.",
  "author": "bugdeployer",
  "credentialOrigins": [
    "https://api.themoviedb.org"
  ]
}
