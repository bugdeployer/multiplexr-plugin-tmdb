{
  "id": "com.bugdeployer.tmdb",
  "version": "0.2.0",
  "name": "TMDB metadata",
  "entry": "plugin.js",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "capabilities": {
    "required": [
      "metadata.provide",
      "http.request",
      "credentials.use"
    ],
    "optional": []
  },
  "contributions": [
    {
      "id": "com.bugdeployer.tmdb:metadata",
      "family": "metadata.provider",
      "title": "TMDB",
      "handler": "metadata.search",
      "kinds": [
        "movie",
        "television"
      ]
    }
  ]
}
